{
  "name": "@wparts/secure-rooms-crypto",
  "version": "0.1.0",
  "description": "E2EE helpers for WParts Secure Rooms (libsodium).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "THREAT-MODEL.md",
    "LICENSE",
